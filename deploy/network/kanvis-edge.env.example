# /etc/kanvis-edge/env — configuración de despliegue en hardware
# Copiar: sudo cp deploy/network/kanvis-edge.env.example /etc/kanvis-edge/env

# Modo de red: ap_only | lan_only | ap_and_lan
NETWORK_MODE=ap_and_lan

# AP de instalación
WLAN_INTERFACE=wlan0
LAN_INTERFACE=eth0
AP_SSID_PREFIX=kanvis
AP_IP=192.168.192.192
AP_NETMASK=24
AP_CHANNEL=6
AP_PASSWORD=kanvis-install
# Dejar vacío AP_PASSWORD para AP abierto (no recomendado)

# ID único del dispositivo (sufijo SSID si no se define DEVICE_ID en .env)
# DEVICE_ID se lee desde /opt/kanvis-edge/.env si existe
