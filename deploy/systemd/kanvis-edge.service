[Unit]
Description=Kanvis Edge Video Gateway
Documentation=https://github.com/kanvis/kanvis-edge
After=network.target kanvis-network.service
# No usar network-online: con solo AP sin internet el target puede no completarse.
# Si usas solo LAN sin AP, comenta After=kanvis-network.service

[Service]
Type=simple
User=kanvis
Group=kanvis
WorkingDirectory=/opt/kanvis-edge
Environment=PYTHONPATH=/opt/kanvis-edge
EnvironmentFile=-/opt/kanvis-edge/.env
EnvironmentFile=-/etc/kanvis-edge/env
ExecStart=/opt/kanvis-edge/.venv/bin/python -m src.main
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
LimitNOFILE=65536

# Sin ProtectSystem/ProtectHome/PrivateTmp: en algunos kernels/sistemas el servicio
# falla al arrancar con status=226/NAMESPACE antes de ejecutar Python.

[Install]
WantedBy=multi-user.target
