# /etc/kanvis-edge/env — ÚNICO fichero de configuración en hardware
# Tras install: /opt/kanvis-edge/.env es un enlace simbólico a este archivo.
# Editar solo aquí: sudo nano /etc/kanvis-edge/env

CONFIG_DIR=config
LOG_LEVEL=INFO

EDGE_API_HOST=0.0.0.0
EDGE_API_PORT=8000
# Opcional: URL fija del panel. Vacío = IP pública detectada automáticamente (recomendado).
# EDGE_PANEL_PUBLIC_URL=http://203.0.113.5:8000

BUFFER_DURATION_SECONDS=60
DEFAULT_PLAYBACK_OFFSET_SEC=6
DEFAULT_PLAYBACK_TEST_OFFSET_SEC=3
PRE_BUFFER_SECONDS=6
POST_BUFFER_SECONDS=24
STREAM_FPS=12

CAMERA_STORE_BACKEND=json

AUTH_MODE=api_key
API_KEY=ktqJobifA965L0KpgdTe

WEBUI_USERNAME=admin
WEBUI_PASSWORD=oryxon2026
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30
WEBUI_TOKEN_EXPIRE_HOURS=24

DDNS_ENABLED=false
DISCOVERY_ENABLED=false

FFMPEG_PATH=ffmpeg
SNAPSHOT_TIMEOUT_SEC=10
FFMPEG_LOG_LEVEL=warning
RELAY_TRANSCODE_PRESET=veryfast

RTSP_GATEWAY_ENABLED=false
RTSP_GATEWAY_LISTEN_HOST=0.0.0.0
RTSP_GATEWAY_PORT=8554
RTSP_GATEWAY_WAN_PORT=55422
MEDIAMTX_BINARY=mediamtx
MEDIAMTX_LOG_LEVEL=info

CLOUD_REPORT_ENABLED=true
CLOUD_REPORT_URL=http://wudalkot.ddns.net:7777/api/v1/kanvis-edges/report-public-ip
CLOUD_ACCESS_TOKEN=ed1ee150a0ef7e5732cb5a38d7161b18a0903453c3852d2ef59eb2f27c1ef086
CLOUD_REPORT_ON_IP_CHANGE_ONLY=true
DEVICE_ID=tienda-001
DEVICE_NAME=store-01-edge
WAN_SYNC_INTERVAL_SECONDS=60

# Usuario Linux kanvis (SSH, VNC, sudo)
KANVIS_OS_PASSWORD=oryxon2026
KANVIS_ENABLE_SSH=true
KANVIS_ENABLE_VNC=true
KANVIS_VNC_DISPLAY=:1

# Red / AP instalación
NETWORK_MODE=ap_and_lan
WLAN_INTERFACE=wlP1p1s0
LAN_INTERFACE=eth0
AP_SSID_PREFIX=kanvis
AP_IP=192.168.192.192
AP_NETMASK=24
AP_CHANNEL=6
AP_PASSWORD=oryxon2026
