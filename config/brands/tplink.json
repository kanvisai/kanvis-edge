{
    "brand": "TP-Link",
    "version": "1.0.0",
    "models": [],
    "default_channels": [
      { "id": "stream1", "label": "Principal (main - 1080p)" },
      { "id": "stream2", "label": "Substream (360p)" }
    ],
    "protocols": {
      "rtsp": {
        "stream_template": "rtsp://{{user}}:{{password}}@{{host}}:{{port}}/{{channel}}",
        "playback_template": "rtsp://{{user}}:{{password}}@{{host}}:{{port}}/Streaming/tracks/{{channel}}?starttime={{starttime}}&endtime={{endtime}}",
       "time_format": "YYYY-MM-DDTHH:mm:ss[Z]",
        "requires_utc": false
      }
    }
  }