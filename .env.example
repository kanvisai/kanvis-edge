# Kanvis Edge — desarrollo local / Docker (copiar a .env en la raíz del repo)
# En HARDWARE use un solo fichero: /etc/kanvis-edge/env (ver deploy/kanvis-edge.env.example)
#
# Kanvis Edge Gateway
CONFIG_DIR=config
# Perfiles RTSP por fabricante: config/brands/<slug>.json
# KANVIS_BRANDS_DIR=config/brands
LOG_LEVEL=INFO

EDGE_API_HOST=0.0.0.0
EDGE_API_PORT=8000
# Opcional: forzar una URL fija en «Datos de conexión». Si está vacío, el edge detecta
# la IP pública solo (ipify, cada ~5 min) — no hace falta rellenarlo si cambia la IP.
# EDGE_PANEL_PUBLIC_URL=http://TU_IP_PUBLICA:8000

# Búfer global (por cámara se puede sobreescribir en cameras.json → buffer.duration_seconds)
BUFFER_DURATION_SECONDS=60
DEFAULT_PLAYBACK_OFFSET_SEC=6
DEFAULT_PLAYBACK_TEST_OFFSET_SEC=3
PRE_BUFFER_SECONDS=6
POST_BUFFER_SECONDS=24
STREAM_FPS=20

CAMERA_STORE_BACKEND=json

AUTH_MODE=api_key
API_KEY=replace-with-strong-api-key

# Panel web instalación (http://IP:8000/)
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change-me-on-first-boot
JWT_SECRET=replace-with-jwt-secret-for-webui-and-api
WEBUI_TOKEN_EXPIRE_HOURS=24

DDNS_ENABLED=false
DISCOVERY_ENABLED=false

FFMPEG_PATH=ffmpeg
SNAPSHOT_TIMEOUT_SEC=10
FFMPEG_LOG_LEVEL=warning
RELAY_TRANSCODE_PRESET=veryfast

# Fase 7 — RTSP gateway unificado (MediaMTX, opcional)
RTSP_GATEWAY_ENABLED=false
RTSP_GATEWAY_LISTEN_HOST=0.0.0.0
RTSP_GATEWAY_PORT=8554
RTSP_GATEWAY_WAN_PORT=55422
# Ruta absoluta recomendada si el binario no está en PATH del servicio systemd
MEDIAMTX_BINARY=/opt/kanvis-edge/bin/mediamtx
MEDIAMTX_LOG_LEVEL=info
# Reinicio preventivo MediaMTX en segundos (0=desactivado; 21600=6h si hace falta)
MEDIAMTX_RESTART_INTERVAL_SEC=0
# Ingesta: sin paquetes RTSP durante N s → reinicio del consumer (default 60)
INGEST_STALE_TIMEOUT_SEC=60
INGEST_MAINTAIN_INTERVAL_SEC=60
LIVE_QUEUE_TRIM_SEC=120

# Fase 6 — Conectividad WAN hacia Kanvis backend
#
# --- Reporte IP (lo habitual en tu arquitectura) ---
# El edge envía public_ip + device_name al backend. La nube NO necesita resolver
# DNS: usa la IP guardada en BD para RTSP (rtsp://<public_ip>:puerto/...).
# DDNS_HOSTNAME (abajo) es solo una ETIQUETA que también se envía al backend si
# está definida; no hace falta DDNS_ENABLED=true ni DDNS_TOKEN.
#
# --- DDNS dinámico (opcional, otro flujo) ---
# Solo si quieres que DuckDNS/No-IP actualicen un registro DNS público.
# DDNS_TOKEN = API secret de tu cuenta en duckdns.org (NO es CLOUD_ACCESS_TOKEN).
DDNS_ENABLED=false
DDNS_PROVIDER=duckdns
DDNS_HOSTNAME=mi-tienda
DDNS_TOKEN=
DDNS_INTERVAL_SECONDS=300

CLOUD_REPORT_ENABLED=false
CLOUD_REPORT_URL=http://kanvis-pilot.ai:7777/api/v1/kanvis-edges/report-public-ip
# Token del edge en Kanvis C4 (body JSON access_token; NO usar Bearer)
CLOUD_ACCESS_TOKEN=
# Alias legacy: CLOUD_REPORT_TOKEN=
CLOUD_REPORT_ON_IP_CHANGE_ONLY=true
DEVICE_ID=tienda-001
# Debe coincidir con device_name registrado en Kanvis (C4)
DEVICE_NAME=store-01-edge
WAN_SYNC_INTERVAL_SECONDS=0

# WebRTC (visor en navegador). Si ICE «conectado» pero pantalla negra con ingesta OK:
# WEBRTC_DIRECT_RTSP=true   # 2ª conexión RTSP; suele mostrar imagen de inmediato
# Tras conectar: GET /api/v1/webrtc/{camera_id}/status → frames_sent debe subir (>0)

# En hardware: red, SSH y OS están en /etc/kanvis-edge/env (plantilla deploy/kanvis-edge.env.example)
